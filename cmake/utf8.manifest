<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Манифест всех exe проекта (приложение, утилиты, тесты): кодовая страница процесса UTF-8.
     Тогда char-API Windows, argv, std::filesystem::path(std::string) и path::string() работают
     в UTF-8 независимо от системной ANSI-страницы (1251, 1252, ...). Нужна Windows 10 1903+. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 и 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
